#!/usr/bin/env bash

ALLOWED_FIELDS="Orientation ImageWidth ImageHeight XResolution YResolution ResolutionUnit ColorSpace BitsPerSample Compression PhotometricInterpretation SamplesPerPixel ExifVersion Copyright"

FOUND_METADATA=0

FILES=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $FILES; do
    if [ -f "$FILE" ]; then
        META=$(exiftool -EXIF:all "$file" | sed -e "s/^\([^:]*\):.*/\1/g" -e "s/[[:blank:]]//g" | grep -vE "$(echo $ALLOWED_FIELDS | tr " " "|")")
        if [ -n "$META" ]; then
            echo "❌ Sensitive metadata found in: $FILE"
            echo "$META"
            echo
            FOUND_METADATA=1
        fi
    fi
done

if [ $FOUND_METADATA -eq 1 ]; then
    echo "🚫 Commit blocked due to sensitive metadata. Use:"
    echo "    exiftool $(echo $ALLOWED_FIELDS | sed 's/\([[:alnum:]]*\)/-\1=/g') -overwrite_original <file>"
    echo "to remove it before committing."
    exit 1
fi

exit 0
