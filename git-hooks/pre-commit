#!/usr/bin/env bash

ALLOWED_FIELDS="Orientation ImageWidth ImageHeight ThumbnailOffset ThumbnailLength XResolution YResolution ResolutionUnit ColorSpace YCbCrPositioning BitsPerSample Compression PhotometricInterpretation SamplesPerPixel ExifVersion SubfileType Copyright Rss"

FOUND_METADATA=0

FILES=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $FILES; do
    if [ -f "$FILE" ]; then
        META=$(exiftool -s -EXIF:all -XMP:all "$FILE" | sed -e "s/^\([[:alnum:]]*\).*/\1/g" | grep -vE "$(echo $ALLOWED_FIELDS | tr " " "|")")
        if [ -n "$META" ]; then
            echo "❌ Sensitive metadata found in: $FILE"
            echo "$META"
            echo
            FOUND_METADATA=1
        fi
    fi
done

if [ $FOUND_METADATA -eq 1 ]; then
    echo "🚫 Commit blocked due to sensitive metadata."
    exit 1
fi

exit 0
