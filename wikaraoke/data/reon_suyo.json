  "lyrics": [
    {"start":13.60,"end":16.88,"text":"Bakit ba","lang":"tgl"},
    {"start":16.88,"end":23.24,"text":"Palagi kang nakasimangot na","lang":"tgl"},
    {"start":23.24,"end":28.32,"text":"Parang pasan mo ang mundo?","lang":"tgl"},
    {"start":28.32,"end":34.42,"text":"Ooh ooh ooh ooh ooh ooh","lang":"tgl"},
    {"start":34.42,"end":38.58,"text":"Ooh ooh","lang":"tgl"},
    {"start":38.58,"end":42.07,"text":"Oh, sinta","lang":"tgl"},
    {"start":42.07,"end":48.34,"text":"Ayaw lagi ba og minaldita","lang":"ceb"},
    {"start":48.34,"end":53.36,"text":"Ikaw ray gihigugma ko","lang":"ceb"},
    {"start":53.36,"end":59.35,"text":"Ooh ooh ooh ooh ooh ooh","lang":"ceb"},
    {"start":59.35,"end":63.94,"text":"Ooh ooh","lang":"ceb"},
    {"start":63.94,"end":67.8,"text":"'Di ko inakalang ganito","lang":"tgl"},
    {"start":67.8,"end":69.96,"text":"Nag-aaway nanaman tayo","lang":"tgl"},
    {"start":69.96,"end":73.42,"text":"At kahit na ako'y galit","lang":"tgl"},
    {"start":73.42,"end":77.58,"text":"At 'di kita pinapansin","lang":"tgl"},
    {"start":77.58,"end":83.73,"text":"Ikaw pa rin ang para sa 'kin","lang":"tgl"},
    {"start":83.73,"end":91.48,"text":"La la la la la la la la la la la la la la la la","lang":"tgl"},
    {"start":91.48,"end":96.21,"text":"La la la la la la la la la la la","lang":"tgl"},
    {"start":96.21,"end":99.54,"text":"Sabi mo","lang":"tgl"},
    {"start":99.54,"end":105.82,"text":"Lalabas tayo pero ang busy mo","lang":"tgl"},
    {"start":105.82,"end":112.41,"text":"Oras lang ang aking hiling sa 'yo","lang":"tgl"},
    {"start":112.41,"end":117.26,"text":"Ooh ooh ooh ooh ooh ooh","lang":"tgl"},
    {"start":117.26,"end":120.96,"text":"Ooh ooh","lang":"tgl"},
    {"start":120.96,"end":124.75,"text":"Oh, langga","lang":"ceb"},
    {"start":124.75,"end":130.92,"text":"Tagda sad ko nimog diyutay diha","lang":"ceb"},
    {"start":130.92,"end":135.87,"text":"Nangluod man ta ko nimo","lang":"ceb"},
    {"start":135.87,"end":142.02,"text":"Ooh ooh ooh ooh ooh ooh","lang":"ceb"},
    {"start":142.02,"end":146.39,"text":"Ooh ooh","lang":"ceb"},
    {"start":146.39,"end":149.94,"text":"'Di ko inakalang ganito","lang":"tgl"},
    {"start":149.94,"end":152.52,"text":"At napasuyo nanaman ako","lang":"tgl"},
    {"start":152.52,"end":156.27,"text":"'Di bale na 'kay tampuhin","lang":"tgl"},
    {"start":156.27,"end":160.2,"text":"At minsan kulang ka sa pansin","lang":"tgl"},
    {"start":160.2,"end":166.3,"text":"Ikaw pa rin ang para sa 'kin","lang":"tgl"},
    {"start":166.3,"end":173.81,"text":"La la la la la la la la la la la la la la la la","lang":"tgl"},
    {"start":173.81,"end":178.92,"text":"La la la la la la la la la la la","lang":"tgl"},
    {"start":178.92,"end":186.62,"text":"La la la la la la la la la la la la la la la la","lang":"tgl"},
    {"start":186.62,"end":192.3,"text":"La la la la la la la la la la la","lang":"tgl"}
