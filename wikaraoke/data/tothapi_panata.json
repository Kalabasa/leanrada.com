{
  "youtubeId": "kpF9Vo2zJ6Q",
  "skip": 9,
  "offset": 9,
  "lyrics": [
    {"start":13.53,"end":20.71,"text":"Litrato man natin ay kumupas","lang":"tgl"},
    {"start":20.71,"end":27.31,"text":"Ikaw aking noon, ngayon, at bukas","lang":"tgl"},
    {"start":27.31,"end":34.58,"text":"Kung paboritong kuwento nati'y magwakas","lang":"tgl"},
    {"start":34.58,"end":41.1,"text":"Ay uulitin kong ikuwento bukas","lang":"tgl"},
    {"start":41.1,"end":48.15,"text":"Sa pagdating ay siyang ating","lang":"tgl"},
    {"start":48.15,"end":54.75,"text":"Buong pusong salubungin","lang":"tgl"},
    {"start":54.75,"end":61.76,"text":"'Di man ngayon tulad ng dati","lang":"tgl"},
    {"start":61.76,"end":70.16,"text":"Ang panata ko'y mananatili","lang":"tgl"},
    {"start":73.26,"end":77.99,"text":"Kun ika man mapungaw","lang":"bik"},
    {"start":77.99,"end":86.22,"text":"Sa sakuyang paghali","lang":"bik"},
    {"start":87.22,"end":92.03,"text":"Dai makakalingaw","lang":"bik"},
    {"start":92.03,"end":97.94,"text":"Na ako mauli","lang":"bik"},
    {"start":101.44,"end":106.09,"text":"Kun ikaw man mahadit","lang":"bik"},
    {"start":106.09,"end":111.74,"text":"Na mapara ining ngirit","lang":"bik"},
    {"start":114.74,"end":120.11,"text":"Kada adlaw na ikinurit","lang":"bik"},
    {"start":120.11,"end":129.62,"text":"Pinili kang daing pirit","lang":"bik"},
    {"start":129.62,"end":136.23,"text":"Sa pag abot kan panahon","lang":"bik"},
    {"start":136.23,"end":142.98,"text":"Sato ining aakuon","lang":"bik"},
    {"start":142.98,"end":149.68,"text":"Dawa ngunyan lain kan dati","lang":"bik"},
    {"start":149.68,"end":159.05,"text":"Ang panata ko'y mananatili","lang":"tgl"},
    {"start":159.05,"end":172.7,"text":"Kaya tahan na","lang":"tgl"},
    {"start":172.7,"end":184.23,"text":"Aking tahanan","lang":"tgl"},
    {"start":186.23,"end":200.07,"text":"Kaya tahan na","lang":"tgl"},
    {"start":200.07,"end":210.07,"text":"Aking tahanan","lang":"tgl"},
    {"start":240.07,"end":247.75,"text":"Oh, sa pagdating ay siyang ating","lang":"tgl"},
    {"start":247.75,"end":254.23,"text":"Taos pusong tatanggapin","lang":"tgl"},
    {"start":254.23,"end":260.96,"text":"Di man ngayon tulad ng dati","lang":"tgl"},
    {"start":260.96,"end":272.94,"text":"Ang panata ko'y mananatili","lang":"tgl"}
  ],
