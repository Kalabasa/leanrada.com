{
  "youtubeId": "aP5Oun_5oc4",
  "lyrics": [
    {"start":0.16,"end":3.61,"text":"This next song is all about love","lang":"eng"},
    {"start":3.61,"end":8.13,"text":"And I wrote it all by myself","lang":"eng"},
    {"start":8.13,"end":17.42,"text":"They try to tell us we're too young","lang":"eng"},
    {"start":17.42,"end":25.92,"text":"Too young to really be in love","lang":"eng"},
    {"start":25.92,"end":32.56,"text":"Bahay namin maliit lamang","lang":"tgl"},
    {"start":32.56,"end":38.4,"text":"Pero, pero, pero, pero malinis 'to pati sa kusina","lang":"tgl"},
    {"start":38.4,"end":44.25,"text":"Kumain man kami laging sama-sama","lang":"tgl"},
    {"start":44.25,"end":47.17,"text":"Pen-pen-pen de sarapen","lang":"tgl"},
    {"start":47.17,"end":50.35,"text":"De kutsilyo de almasen","lang":"tgl"},
    {"start":50.35,"end":53.01,"text":"Haw-haw-haw de karabaw","lang":"tgl"},
    {"start":53.01,"end":56.2,"text":"De karabaw de batuten","lang":"tgl"},
    {"start":56.2,"end":59.12,"text":"Pengeng singko pambili ng puto","lang":"tgl"},
    {"start":59.12,"end":62.04,"text":"Sa mga tindera ng bitso-bitso","lang":"tgl"},
    {"start":62.04,"end":64.96,"text":"Skyflakes, Coke, 500, pahingi ng kiss","lang":"tgl"},
    {"start":64.96,"end":67.88,"text":"Pambayad mo sa jeepney kulang pa ng diyes","lang":"tgl"},
    {"start":67.88,"end":70.8,"text":"Mahal ko si Toyang","lang":"tgl"},
    {"start":70.8,"end":73.73,"text":"Pagkat siya'y simple lamang","lang":"tgl"},
    {"start":73.73,"end":76.65,"text":"Kahit na mamroblema","lang":"tgl"},
    {"start":76.65,"end":79.3,"text":"Basta't kami ay magkasama","lang":"tgl"},
    {"start":79.3,"end":85.41,"text":"Madalas man kaming walang pera","lang":"tgl"},
    {"start":85.41,"end":88.07,"text":"Makita lang ang kislap ng kanyang mga mata","lang":"tgl"},
    {"start":88.07,"end":91.26,"text":"Ako ay busog na","lang":"tgl"},
    {"start":91.26,"end":96.8,"text":"At nakatambay kami sa Tandang Sora","lang":"tgl"},
    {"start":111.17,"end":116.17,"text":"Eman, unsa man?","lang":"ceb"},
    {"start":128.17,"end":134.55,"text":"Ti ayat ti maysa nga baro","lang":"ilo"},
    {"start":134.55,"end":140.92,"text":"Ket balasang nga natalna","lang":"ilo"},
    {"start":140.92,"end":147.83,"text":"Uray man, uray man, uray man","lang":"ilo"},
    {"start":147.83,"end":154.2,"text":"Haan unay nga nadonya","lang":"ilo"},
    {"start":154.2,"end":160.31,"text":"Bahay namin maliit lamang","lang":"tgl"},
    {"start":160.31,"end":165.89,"text":"Pero, pero, pero, pero malinis 'to pati sa kusina","lang":"tgl"},
    {"start":165.89,"end":171.73,"text":"Kumain man kami laging sama-sama","lang":"tgl"},
    {"start":171.73,"end":174.65,"text":"Pen-pen-pen de sarapen","lang":"tgl"},
    {"start":174.65,"end":177.57,"text":"De kutsilyo de almasen","lang":"tgl"},
    {"start":177.57,"end":180.49,"text":"Haw-haw-haw de karabaw","lang":"tgl"},
    {"start":180.49,"end":183.15,"text":"De karabaw de batuten","lang":"tgl"},
    {"start":183.15,"end":186.34,"text":"Mahal ko si Toyang","lang":"tgl"},
    {"start":186.34,"end":188.99,"text":"Pagkat siya'y simple lamang","lang":"tgl"},
    {"start":188.99,"end":191.91,"text":"Kahit na mamroblema","lang":"tgl"},
    {"start":191.91,"end":196.16,"text":"Basta't kami ay magkasama","lang":"tgl"},
    {"start":199.05,"end":203.34,"text":"Toyang oh Toyang","lang":"tgl"},
    {"start":203.34,"end":206.26,"text":"Please pakinggan mo naman ako","lang":"tgl"},
    {"start":206.26,"end":208.36,"text":"I will always be true to you","lang":"eng"},
    {"start":212.36,"end":213.43,"text":"Take it","lang":"eng"},
    {"start":213.43,"end":227.4,"text":"We were not too young at all","lang":"eng"}
  ],
