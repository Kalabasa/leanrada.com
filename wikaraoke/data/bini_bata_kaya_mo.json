  "lyrics": [
    {"start":0,"end":3.692,"text":"Bata bata 'wag matakot sa dilim","lang":"tgl"},
    {"start":3.692,"end":7.385,"text":"Mata nilang dilaw na nakatingin","lang":"tgl"},
    {"start":7.385,"end":11.077,"text":"Bata bata 'wag matakot harapin","lang":"tgl"},
    {"start":11.077,"end":14.769,"text":"Ipakita mo kung ano kayang gawin","lang":"tgl"},
    {"start":15.769,"end":18.462,"text":"Dive in the ocean and take that leap","lang":"eng"},
    {"start":19.462,"end":22.154,"text":"You'll come and see that it's not that deep","lang":"eng"},
    {"start":23.154,"end":25.846,"text":"Go take my hand and just jump with me","lang":"eng"},
    {"start":26.846,"end":29.538,"text":"Ayg kabalaka let's count to three","lang":"ceb"},
    {"start":30.038,"end":33.231,"text":"Ooh, bata ba't ka nangangamba?","lang":"tgl"},
    {"start":33.231,"end":36.923,"text":"Sumabay sa alon 'wag matakot you'll see","lang":"tgl"},
    {"start":36.923,"end":40.315,"text":"Go with the flow you can take it slow","lang":"eng"},
    {"start":40.315,"end":44.308,"text":"Take your time, keep it light, no pressure, be free","lang":"eng"},
    {"start":44.308,"end":48.0,"text":"Bata bata 'wag matakot sa dilim","lang":"tgl"},
    {"start":48.0,"end":51.692,"text":"Mata nilang dilaw na nakatingin","lang":"tgl"},
    {"start":51.692,"end":55.385,"text":"Bata bata 'wag matakot harapin","lang":"tgl"},
    {"start":55.385,"end":59.077,"text":"Ipakita mo kung ano kayang gawin","lang":"tgl"},
    {"start":59.077,"end":62.769,"text":"Bata bata 'wag matakot sa dilim","lang":"tgl"},
    {"start":62.769,"end":66.462,"text":"Mata nilang dilaw na nakatingin","lang":"tgl"},
    {"start":66.462,"end":70.154,"text":"Bata bata 'wag matakot harapin","lang":"tgl"},
    {"start":70.154,"end":73.846,"text":"Ipakita mo kung ano kayang gawin","lang":"tgl"},
    {"start":74.346,"end":75.692,"text":"Hard times but don't ever slow down","lang":"eng"},
    {"start":75.692,"end":77.538,"text":"Stars shine brighter when the sun comes down","lang":"eng"},
    {"start":77.538,"end":79.385,"text":"No stress, bata, keep your head up","lang":"eng"},
    {"start":79.385,"end":81.231,"text":"When you fall down south, don't forget to stand up","lang":"eng"},
    {"start":82.231,"end":84.077,"text":"Pain and pressure make a diamond","lang":"eng"},
    {"start":84.077,"end":85.923,"text":"Ride the waves like Poseidon","lang":"eng"},
    {"start":85.923,"end":87.769,"text":"Stay humble, stay grinding","lang":"eng"},
    {"start":87.769,"end":88.615,"text":"Make the noise, go silent","lang":"eng"},
    {"start":88.615,"end":90.162,"text":"I'm steppin' on, steppin' on gas","lang":"eng"},
    {"start":90.162,"end":92.008,"text":"Not lookin' back, I just wanna go fast","lang":"eng"},
    {"start":92.008,"end":93.854,"text":"Ain't afraid, I know I'm gonna surpass","lang":"eng"},
    {"start":93.854,"end":95.6,"text":"This time you'll see me, colors contrast","lang":"eng"},
    {"start":95.6,"end":97.446,"text":"Bata won't you come with me","lang":"eng"},
    {"start":97.446,"end":99.292,"text":"See your dreams be free","lang":"eng"},
    {"start":99.292,"end":101.138,"text":"Dili mag disagree","lang":"ceb"},
