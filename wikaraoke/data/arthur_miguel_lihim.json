{
  "youtubeId": "Gi0y0eLuYtI",
  "skip": 3,
  "offset": 1.8,
  "lyrics": [
    {"start":9.13,"end":16.29,"text":"Humawak ka sa 'kin, sundan aking himig","lang":"tgl"},
    {"start":16.29,"end":22.65,"text":"'Wag nang magtago, 'di naman mababago","lang":"tgl"},
    {"start":22.65,"end":29.66,"text":"'Di kailangang sabihin, walang dapat gawin","lang":"tgl"},
    {"start":29.66,"end":36.11,"text":"Oh, aking bituin, ikaw ang hiling","lang":"tgl"},
    {"start":36.11,"end":39.48,"text":"'Wag mong pigilan, hayaan mong kusa","lang":"tgl"},
    {"start":39.48,"end":43.37,"text":"Humawak ka sa 'kin, sundin ang damdamin","lang":"tgl"},
    {"start":43.37,"end":46.7,"text":"Oh, sumama ka sa 'kin","lang":"tgl"},
    {"start":46.7,"end":49.19,"text":"At tayo ay","lang":"tgl"},
    {"start":49.19,"end":52.61,"text":"Sasayaw sa kulog at ulan","lang":"tgl"},
    {"start":52.61,"end":56.11,"text":"Iikutin ang tala at buwan","lang":"tgl"},
    {"start":56.11,"end":59.6,"text":"Habang tayo ay naliligaw","lang":"tgl"},
    {"start":59.6,"end":63,"text":"Pakinggan ang puso, 'wag nang bibitaw","lang":"tgl"},
    {"start":63,"end":66.5,"text":"'Wag nang magtagu-taguan","lang":"tgl"},
    {"start":66.5,"end":69.92,"text":"Kita naman sa liwanag ng buwan","lang":"tgl"},
    {"start":69.92,"end":75.0,"text":"Ang lihim na pagtingin","lang":"tgl","highlight":true},
    {"start":75.0,"end":78.5,"text":"Kailan aaminin?","lang":"tgl"},
    {"start":91.89,"end":99.16,"text":"Huyop-huyop kan paros, tigdadara ka sakuya","lang":"bik"},
    {"start":99.16,"end":105.52,"text":"Garo nakaplano pero dai sigurado","lang":"bik"},
    {"start":105.52,"end":114.73,"text":"Nakaw mong tingin, sa 'yo lang hihimbing","lang":"tgl"},
    {"start":114.73,"end":119.25,"text":"Ikaw at ako ang nasa likod ng mga ulap","lang":"tgl"},
    {"start":119.25,"end":122.3,"text":"'Wag mong pigilan, hayaan mong kusa","lang":"tgl"},
    {"start":122.3,"end":126.51,"text":"Humawak ka sa 'kin, sundin ang damdamin","lang":"tgl"},
    {"start":126.51,"end":130.0,"text":"Oh, sumama ka sa 'kin","lang":"tgl"},
    {"start":130.0,"end":132.04,"text":"At tayo ay","lang":"tgl"},
    {"start":132.04,"end":135.5,"text":"Sabay kitang mabayle sa uran","lang":"bik"},
    {"start":135.5,"end":139,"text":"Iikutin ang tala at buwan","lang":"tgl"},
    {"start":139,"end":142.5,"text":"Habang kita ay nawawara","lang":"bik"},
    {"start":142.5,"end":145.84,"text":"Pakinggan ang puso, 'wag nang bibitaw","lang":"tgl"},
    {"start":145.84,"end":149.5,"text":"Dai na magtagu-taguan","lang":"bik"},
    {"start":149.5,"end":153.12,"text":"Kita naman sa liwanag ng buwan","lang":"tgl"},
    {"start":153.12,"end":158.0,"text":"Ang lihim na pagtingin","lang":"tgl","highlight":true},
    {"start":158.0,"end":162.0,"text":"Kailan aaminin?","lang":"tgl"},
