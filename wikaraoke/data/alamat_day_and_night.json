  "lyrics": [
    {"start":14.73,"end":17.18,"text":"Araw, ulap, simoy ng hangin","lang":"tgl"},
    {"start":17.18,"end":19.63,"text":"Puno, dagat, at ang buhangin","lang":"tgl"},
    {"start":19.63,"end":21.23,"text":"Lahat ng 'yan naging payak","lang":"tgl"},
    {"start":21.23,"end":25.14,"text":"Nung marinig ang tinig mo","lang":"tgl"},
    {"start":25.14,"end":27.73,"text":"Lapit, usap at nang yayain","lang":"tgl"},
    {"start":27.73,"end":30.09,"text":"Isang buong araw kang naging akin","lang":"tgl"},
    {"start":30.09,"end":31.59,"text":"Ang tangi lang natitiyak","lang":"tgl"},
    {"start":31.59,"end":34.49,"text":"Mula noo'y nabihag mo","lang":"tgl"},
    {"start":34.49,"end":37.17,"text":"I think about you day and night","lang":"eng"},
    {"start":37.17,"end":39.66,"text":"Oh, naghunahuna ko nimo","lang":"ceb"},
    {"start":39.66,"end":42.14,"text":"Girl you're always on my mind","lang":"eng"},
    {"start":42.14,"end":43.34,"text":"I think about you","lang":"eng"},
    {"start":43.34,"end":44.3,"text":"Adlaw ug gabii","lang":"ceb"},
