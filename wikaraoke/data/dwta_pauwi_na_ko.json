  "lyrics": [
    {"start":0.02,"end":1.37,"text":"'Di ko matiis","lang":"tgl"},
    {"start":1.37,"end":2.74,"text":"Ika'y nami-miss","lang":"tgl"},
    {"start":2.74,"end":5.49,"text":"Naiinis kapag umaalis","lang":"tgl"},
    {"start":5.49,"end":14.17,"text":"Puwede bang dito ka na lang, oh, please?","lang":"tgl"},
    {"start":14.17,"end":19.35,"text":"Kahit ilang oras pa lang ang nakakalipas nang magkalayo","lang":"tgl"},
    {"start":19.35,"end":24.74,"text":"Para bang ilang taon na hindi kita nasisilayan","lang":"tgl"},
    {"start":24.74,"end":29.91,"text":"Kahit sa'n pa mapunta, ikaw naalala ko palagi","lang":"tgl"},
    {"start":29.91,"end":34.65,"text":"Kung puwede lang ikaw na lang nasa 'king tabi","lang":"tgl"},
    {"start":34.65,"end":36.02,"text":"'Di ko matiis","lang":"tgl"},
    {"start":36.02,"end":37.39,"text":"Ika'y nami-miss","lang":"tgl"},
    {"start":37.39,"end":39.9,"text":"Naiinis kapag umaalis","lang":"tgl"},
    {"start":39.9,"end":47.28,"text":"Puwede bang dito ka na lang, oh, please?","lang":"tgl"},
    {"start":47.28,"end":52.46,"text":"Pauwi na 'ko","lang":"tgl"},
    {"start":52.46,"end":58.18,"text":"Patungo sa 'yo","lang":"tgl"},
    {"start":58.18,"end":63.14,"text":"'Di na mapigilan","lang":"tgl"},
    {"start":63.14,"end":68.78,"text":"Gusto kang mahagkan","lang":"tgl"},
    {"start":80.78,"end":86.02,"text":"Dawa sisay pa an masabatan ko, dai ta 'ka tukalan","lang":"bik"},
    {"start":86.02,"end":91.55,"text":"Pangako ko, ikaw lang ang nag-iisang tahanan","lang":"tgl"},
    {"start":91.55,"end":96.76,"text":"Dawa nuarin magsain, dai ta 'ka nanggad bayaan","lang":"bik"},
    {"start":96.76,"end":104.11,"text":"Matagal man ang biyahe, ikaw pa rin ang uuwian","lang":"tgl"},
    {"start":104.11,"end":105.48,"text":"'Di ko matiis","lang":"tgl"},
    {"start":105.48,"end":106.85,"text":"Ika'y nami-miss","lang":"tgl"},
    {"start":106.85,"end":109.55,"text":"Naiinis kapag umaalis","lang":"tgl"},
    {"start":109.55,"end":116.85,"text":"Puwede bang dito ka na lang, oh, please?","lang":"tgl"},
