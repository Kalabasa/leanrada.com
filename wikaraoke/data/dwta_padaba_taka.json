  "lyrics": [
    {"start":0.31,"end":2.24,"text":"Kumusta ang biyahe?","lang":"bik"},
    {"start":2.24,"end":5.38,"text":"Napagal ka daw?","lang":"bik"},
    {"start":5.38,"end":11.36,"text":"Mari na pinagluto taka na Bicol express","lang":"bik"},
    {"start":11.36,"end":18.0,"text":"Pancit bato igwang laing na may","lang":"bik"},
    {"start":18.0,"end":21.11,"text":"Siling labyu","lang":"bik"},
    {"start":22.11,"end":24,"text":"Ay labuyo","lang":"bik"},
    {"start":28.24,"end":30.56,"text":"Kumusta ang aldaw mo?","lang":"bik"},
    {"start":30.56,"end":33.14,"text":"Ibahan mo ako","lang":"bik"},
    {"start":33.14,"end":42.32,"text":"Lilibuton niyatong duwa an kaBicolan","lang":"bik"},
    {"start":42.32,"end":48.44,"text":"Garo ka si Mayon na magayon","lang":"bik"},
    {"start":48.44,"end":53.75,"text":"Digdi ka lang","lang":"bik"},
    {"start":53.75,"end":57.48,"text":"Padaba taka","lang":"bik"},
    {"start":57.48,"end":63.67,"text":"Daing ibang mumuyahon kundi ika","lang":"bik"},
    {"start":63.67,"end":67.59,"text":"Papadabaon taka","lang":"bik"},
    {"start":67.59,"end":73.97,"text":"Sagkod pa man kita maggurang","lang":"bik"},
    {"start":73.97,"end":81.5,"text":"Daing ibang papadabaon pa","lang":"bik"},
    {"start":81.5,"end":88.0,"text":"Kundi ika","lang":"bik"},
    {"start":89.65,"end":91.85,"text":"Kumusta? Pahingalo na","lang":"bik"},
    {"start":91.85,"end":94.41,"text":"Marabason kita","lang":"bik"},
    {"start":94.41,"end":97.0,"text":"Binakalan takang pili nut","lang":"bik"},
    {"start":97.0,"end":102.49,"text":"Asin mga pang-pasalubong","lang":"bik"},
    {"start":103.49,"end":109.89,"text":"Sana napaugma takang maray","lang":"bik"},
    {"start":109.89,"end":116.09,"text":"Sako ka lang","lang":"bik"},
    {"start":116.09,"end":120.08,"text":"Padaba taka","lang":"bik"},
    {"start":120.08,"end":126.09,"text":"Daing ibang mumuyahon kundi ika","lang":"bik"},
    {"start":126.09,"end":130.07,"text":"Papadabaon taka","lang":"bik"},
