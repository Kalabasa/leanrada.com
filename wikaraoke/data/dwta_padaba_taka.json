    {"start":136.71,"end":144.04,"text":"Daing ibang papadabaon pa","lang":"bik"},
    {"start":144.04,"end":150.0,"text":"Kundi ika","lang":"bik"},
    {"start":167.27,"end":169.8,"text":"Ini pa lang sa ngunyan","lang":"bik"},
    {"start":169.8,"end":172.31,"text":"An kaya kong gibuhon","lang":"bik"},
    {"start":172.31,"end":183,"text":"Pano pa kaya kun sabihon ko na","lang":"bik"},
    {"start":185.33,"end":188.8,"text":"Padaba taka","lang":"bik"},
    {"start":188.8,"end":198.11,"text":"Daing ibang mumuyahon kundi ika","lang":"bik"},
    {"start":198.11,"end":201.83,"text":"Mahal kita","lang":"tgl"},
    {"start":201.83,"end":207.76,"text":"Walang ibang gugustuhin kundi ikaw","lang":"tgl"},
