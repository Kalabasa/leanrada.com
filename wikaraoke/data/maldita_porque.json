{
  "youtubeId": "70hm-evXbNM",
  "lyrics": [
    {"start":19.57,"end":24.38,"text":"Tulala lang sa 'king kuwarto","lang":"tgl"},
    {"start":24.38,"end":29.08,"text":"At nagmumuni-muni","lang":"tgl"},
    {"start":29.08,"end":34.0,"text":"Ang tanong sa 'king sarili","lang":"tgl"},
    {"start":34.0,"end":40.64,"text":"\"Sa'n ako nagkamali?\"","lang":"tgl"},
    {"start":40.64,"end":50.27,"text":"Bakit sa iyo pa nagkagusto?","lang":"tgl"},
    {"start":50.27,"end":57.96,"text":"Parang bula, ika'y naglaho","lang":"tgl"},
    {"start":57.96,"end":62.66,"text":"Por que contigo yo ya escogi?","lang":"cbk"},
    {"start":62.66,"end":67.61,"text":"Ahora, mi corazon ta sufri","lang":"cbk"},
    {"start":67.61,"end":72.45,"text":"Bien simple lang yo ta pedi","lang":"cbk"},
    {"start":72.45,"end":78.52,"text":"Era senti tu el cosa yo ya senti","lang":"cbk"},
    {"start":78.52,"end":84.57,"text":"Ta pedi milagro, vira'l tiempo","lang":"cbk"},
    {"start":84.57,"end":88.21,"text":"El mali hace derecho","lang":"cbk"},
    {"start":88.21,"end":94.15,"text":"Na de mio rezo ta pedi yo","lang":"cbk"},
    {"start":94.15,"end":98.5,"text":"Era olvida yo contigo","lang":"cbk"},
    {"start":105.98,"end":110.73,"text":"Ang lahat ay binigay ko","lang":"tgl"},
    {"start":110.73,"end":115.49,"text":"Ngayon ay sising-sisi","lang":"tgl"},
    {"start":115.49,"end":120.35,"text":"Sobra-sobra ang parusa","lang":"tgl"},
    {"start":120.35,"end":126.96,"text":"'Di alam kung kaya pa","lang":"tgl"},
    {"start":126.96,"end":136.51,"text":"Bakit sa iyo pa nagkagusto?","lang":"tgl"},
    {"start":136.51,"end":144.38,"text":"Parang bula, ika'y naglaho","lang":"tgl"},
    {"start":144.38,"end":149.17,"text":"Por que contigo yo ya escogi?","lang":"cbk"},
    {"start":149.17,"end":153.99,"text":"Ahora, mi corazon ta sufri","lang":"cbk"},
    {"start":153.99,"end":158.62,"text":"Bien simple lang yo ta pedi","lang":"cbk"},
    {"start":158.62,"end":165.1,"text":"Era senti tu el cosa yo ya senti","lang":"cbk"},
    {"start":165.1,"end":170.82,"text":"Ta pedi milagro, vira'l tiempo","lang":"cbk"},
    {"start":170.82,"end":174.79,"text":"El mali hace derecho","lang":"cbk"},
    {"start":174.79,"end":180.36,"text":"Na de mio rezo ta pedi yo","lang":"cbk"},
    {"start":180.36,"end":184.52,"text":"Era olvida yo contigo","lang":"cbk"},
    {"start":184.52,"end":188.73,"text":"'Wag nang lumapit o tumawag pa","lang":"tgl"},
    {"start":188.73,"end":194.15,"text":"At baka masampal lang kita","lang":"tgl"},
    {"start":194.15,"end":198.4,"text":"'Di babalikan, magsisi ka man","lang":"tgl"},
    {"start":198.4,"end":205.01,"text":"Ako ay lisanin","lang":"tgl"},
    {"start":205.01,"end":210.74,"text":"Por que contigo yo ya escogi?","lang":"cbk"},
    {"start":210.74,"end":216.3,"text":"Ahora, mi corazon ta sufri","lang":"cbk"},
    {"start":216.3,"end":222.14,"text":"Bien simple lang yo ta pedi","lang":"cbk"},
    {"start":222.14,"end":233.12,"text":"Era senti tu el cosa yo ya senti","lang":"cbk"},
    {"start":233.12,"end":239.07,"text":"Bakit ikaw pa ang napili?","lang":"tgl"},
    {"start":239.07,"end":244.51,"text":"Ngayon, ang puso ko ay sawi","lang":"tgl"},
    {"start":244.51,"end":250.23,"text":"Kay simple lang ng aking hiling","lang":"tgl"},
    {"start":250.23,"end":257.52,"text":"Na madama mo rin ang pait at pighati","lang":"tgl"},
    {"start":257.52,"end":264.23,"text":"Sana'y magmilagro, mabalik ko","lang":"tgl"},
    {"start":264.23,"end":269.01,"text":"Mali ay maideretso","lang":"tgl"},
    {"start":269.01,"end":275.64,"text":"'Pinagdarasal ko sa 'king puso","lang":"tgl"},
    {"start":275.64,"end":282.19,"text":"Na mabura na sa isip ko","lang":"tgl"}
  ],
