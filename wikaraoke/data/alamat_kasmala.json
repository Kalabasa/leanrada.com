{
  "youtubeId": "bo3XaelW2yo",
  "lyrics": [
    {"start":4.42,"end":7.51,"text":"Unang sulyap mo pa lamang","lang":"tgl"},
    {"start":7.51,"end":9.66,"text":"Suminsay sa liknayan","lang":"tgl"},
    {"start":9.66,"end":12.74,"text":"Nahulog na ako","lang":"tgl"},
    {"start":12.74,"end":15.98,"text":"Agaran, walang paliwanagan","lang":"tgl"},
    {"start":15.98,"end":18.95,"text":"'Di ko malabanan nadaramang ito","lang":"tgl"},
    {"start":18.95,"end":21.79,"text":"Alamat, handa, 'rap!","lang":"tgl"},
    {"start":21.79,"end":23.92,"text":"Walang biro, ang ganda ng hubog mo","lang":"tgl"},
    {"start":23.92,"end":25.88,"text":"'Di katakataka na nahulog 'to","lang":"tgl"},
    {"start":25.88,"end":27.43,"text":"Handa akong sundan ka sa'n mang sulok","lang":"tgl"},
    {"start":27.43,"end":29.78,"text":"O saan pa mang tugatog ng ating mundo","lang":"tgl"},
    {"start":29.78,"end":32.05,"text":"Bakit nga ba'ng lakas ng dating mo sa 'kin?","lang":"tgl"},
    {"start":32.05,"end":34.33,"text":"Natutuliro nang 'di ko akalain","lang":"tgl"},
    {"start":34.33,"end":35.77,"text":"Puso'y bumubugso","lang":"tgl"},
    {"start":35.77,"end":38.37,"text":"Dala ng hiwagang dinudulot mo","lang":"tgl"},
    {"start":38.37,"end":42.35,"text":"Alam mo bang sa 'yo'y humahanga?","lang":"tgl"},
    {"start":42.35,"end":46.16,"text":"Gandang mula ulo hanggang paa","lang":"tgl"},
    {"start":46.16,"end":50.36,"text":"P'wede bang makisuyo sa dalagang marahuyo?","lang":"tgl"},
    {"start":50.36,"end":54.75,"text":"Ano mang nais mo ay gagawin","lang":"tgl"},
    {"start":54.75,"end":57.86,"text":"Kasmala, talagang kakaiba","lang":"tgl"},
    {"start":57.86,"end":60.12,"text":"At nabighani sa iyong ganda","lang":"tgl"},
    {"start":60.12,"end":63.09,"text":"Para bang mundo'y huminto nang dahil sa 'yo","lang":"tgl"},
    {"start":63.09,"end":66.13,"text":"Kasmala, talagang kakaiba","lang":"tgl"},
    {"start":66.13,"end":68.75,"text":"'Di na kailangan pa ng iba","lang":"tgl"},
    {"start":68.75,"end":71.04,"text":"Ako'y lakas-tama sa 'yo, ba't ganito?","lang":"tgl"},
    {"start":71.04,"end":73.99,"text":"Yeah, daw isa ka diwata akon nadangtan","lang":"hil"},
    {"start":73.99,"end":75.93,"text":"Sa kalayo, gusto ka makahampang","lang":"hil"},
    {"start":75.93,"end":78.03,"text":"Pasensiya lang kung medyo nagarekta","lang":"hil"},
    {"start":78.03,"end":80.24,"text":"Game ka? Oops, wait, ha?","lang":"tgl"},
    {"start":80.24,"end":82,"text":"Makapaniglo ka lupa","lang":"pam"},
    {"start":82,"end":84.28,"text":"'Ne pa lagu'ing kekang utak","lang":"pam"},
    {"start":84.28,"end":86.77,"text":"Ako'y nahulog sa patibong","lang":"tgl"},
    {"start":86.77,"end":88.02,"text":"At 'di na makawala","lang":"tgl"},
    {"start":88.02,"end":92.73,"text":"Kabalo ba ka'ng nakadayeg ko nimo","lang":"ceb"},
    {"start":92.73,"end":96.02,"text":"Gikan sa tiil hangtod ulo?","lang":"ceb"},
    {"start":96.02,"end":100.61,"text":"Anian nga kinapintas, makabang-ar kasla agas","lang":"ilo"},
    {"start":100.61,"end":104.89,"text":"Ano tim karuyag, hihimuon ko, yeah","lang":"war"},
    {"start":104.89,"end":108.01,"text":"Kasmala, talagang kakaiba","lang":"tgl"},
    {"start":108.01,"end":110.23,"text":"At nabighani sa iyong ganda","lang":"tgl"},
    {"start":110.23,"end":113.17,"text":"Para bang mundo'y huminto nang dahil sa 'yo","lang":"tgl"},
    {"start":113.17,"end":116.25,"text":"Kasmala, talagang kakaiba","lang":"tgl"},
    {"start":116.25,"end":118.82,"text":"'Di na kailangan pa ng iba","lang":"tgl"},
    {"start":118.82,"end":123.22,"text":"Ako'y lakas-tama sa 'yo, ba't ganito?","lang":"tgl"},
    {"start":123.22,"end":128.98,"text":"Sa hiro mo 'yan sabihon, oh, yeah","lang":"bik"},
    {"start":128.98,"end":133.29,"text":"Gare nagbabayle sa diklom","lang":"bik"},
    {"start":133.29,"end":136.1,"text":"Ikaw lang ang 'di mapan-, 'di mapantayan","lang":"tgl"},
    {"start":136.1,"end":137.23,"text":"Kahit sino man","lang":"tgl"},
    {"start":137.23,"end":140.16,"text":"Ikaw lang ang 'di mapan-, 'di mapantayan","lang":"tgl"},
    {"start":140.16,"end":144.56,"text":"Ooh, ooh, ooh, ooh, yeah","lang":"tgl"},
    {"start":144.56,"end":147,"text":"Kasmala, talagang kakaiba","lang":"tgl"},
    {"start":147,"end":150.12,"text":"At nabighani sa iyong ganda","lang":"tgl"},
    {"start":150.12,"end":152.88,"text":"Para bang mundo'y huminto nang dahil sa 'yo","lang":"tgl"},
    {"start":152.88,"end":155.58,"text":"Kasmala, talagang kakaiba","lang":"tgl"},
    {"start":155.58,"end":158.26,"text":"'Di na kailangan pa ng iba","lang":"tgl"},
    {"start":158.26,"end":160.83,"text":"Ako'y lakas-tama sa 'yo, ba't ganito?","lang":"tgl"},
    {"start":160.83,"end":162.83,"text":"Sa dibdib ko at bibig ko, ikaw lang ang laman","lang":"tgl"},
    {"start":162.83,"end":164.94,"text":"Daigdig ko'y nayanig nu'ng ikaw ay dumaan","lang":"tgl"},
    {"start":164.94,"end":167.07,"text":"Sa aking harapan, nabighani mo, kaya","lang":"tgl"},
    {"start":167.07,"end":169.25,"text":"Ako'y lakas-tama sa 'yo, ba't ganito?","lang":"tgl"},
    {"start":169.25,"end":171.39,"text":"Tuo lang sa ako, pirmi nako ginaampo","lang":"ceb"},
    {"start":171.39,"end":173.78,"text":"Kasingkasing nimo nga maako, 'kaw na way makalabaw","lang":"ceb"},
    {"start":173.78,"end":175.13,"text":"Nasa imo na'ng tanan maong","lang":"ceb"},
    {"start":175.13,"end":177.86,"text":"Ako'y lakas-tama sa 'yo, ba't ganito","lang":"tgl"},
    {"start":177.86,"end":180.11,"text":"Kasmala","lang":"tgl"}
  ],
