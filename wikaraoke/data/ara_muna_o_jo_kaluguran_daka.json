    {"start":9.4,"end":13.09,"text":"Tinatanong kung mahal kita,","lang":"tgl"},
    {"start":13.09,"end":17.25,"text":"At bakit nagkahiwalay","lang":"tgl"},
    {"start":17.25,"end":21.24,"text":"Sa puso ko'y di matanggap,","lang":"tgl"},
    {"start":21.24,"end":25,"text":"Pagkat mahal kita","lang":"tgl"},
    {"start":25,"end":33,"text":"Ako'y nanalangin na makapiling ka","lang":"tgl"},
    {"start":33,"end":42.5,"text":"Ang ibig kong sabihin lahat ay gagawin ko","lang":"tgl"},
    {"start":42.5,"end":45.75,"text":"O jo kaluguran daka","lang":"pam"},
    {"start":45.75,"end":50.01,"text":"Kaluguran sobra-sobra","lang":"pam"},
    {"start":50.01,"end":57.26,"text":"Kasara da reng mata pantunan daka","lang":"pam"},
    {"start":57.26,"end":61.25,"text":"Lawen daka angga king mate ku,","lang":"pam"},
    {"start":61.25,"end":65.25,"text":"Uling ika ing lulugud kaku","lang":"pam"},
    {"start":65.25,"end":72,"text":"Lawen daka, o jo, hanggang atin ka pang tau","lang":"pam"},
    {"start":79.35,"end":87,"text":"Kapag naaalala ang kahapong kay saya","lang":"tgl"},
    {"start":87,"end":94.25,"text":"Muli't muling bumabalik ang tamis ng pagsinta","lang":"tgl"},
